{com}. local res_6 = _b[LUL]
{txt}
{com}. 
. /*
> gen orientation = ""
> replace orientation = "left-left" if _n==1
> replace orientation = "right-right" if _n==2
> replace orientation = "center-center" if _n==3
> replace orientation = "left-right" if _n==4
> replace orientation = "left-center" if _n==5
> replace orientation = "center-right" if _n==6
> */
. 
. gen sum_effect = .
{txt}(294,306 missing values generated)

{com}. replace sum_effect = `res_1' in 1  // left-left
{txt}(1 real change made)

{com}. replace sum_effect = `res_2' in 2 // right-right
{txt}(1 real change made)

{com}. replace sum_effect = `res_3' in 3  // center-center
{txt}(1 real change made)

{com}. replace sum_effect = `res_4' in 4 // left-right
{txt}(1 real change made)

{com}. replace sum_effect = `res_5' in 5  // left-center
{txt}(1 real change made)

{com}. replace sum_effect = `res_6' in 6 // center-right       
{txt}(1 real change made)

{com}. 
. cap drop n
{txt}
{com}. gen n = _n
{txt}
{com}. * Create Graph B: Effect on sum of political opinions  
. graph bar sum_effect in 1/6, ///
>         over(n, label(angle(45)) relabel(1 "left-left" 2 "right-right" 3 "center-center" 4 "left-right" 5 "left-center" 6 "center-right")) ///
>         ytitle("Effect on the pair's sum of political opinions") ///
>     ylabel(-1(0.5)1.5) ///
>     bar(1, color("31 119 180")) ///
>     graphregion(color(white)) ///
>     plotregion(color(white)) ///
>     name(graph_b, replace)
{res}{txt}
{com}.         // title("(B) Effect on the pair's sum of political opinions", position(11) size(medium))
. graph export "$path/Results/Figure3b.png", replace width(800) height(600)
{txt}{p 0 4 2}
