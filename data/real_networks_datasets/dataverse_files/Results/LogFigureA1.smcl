{com}. /*
>  Intens2plus |  -1.198854    .353457    -3.39   0.001    -1.891634   -.5060755
>   Resid2plus |   1.124088   .3572091     3.15   0.002     .4239546    1.824221
>      Intens1 |  -.0947624   .1459922    -0.65   0.516    -.3809084    .1913836
> */
. global coeff_nu2 = 1.124088
{txt}
{com}. global coeff_L1 = -.0947624
{txt}
{com}. global coeff_L2 = -1.198854
{txt}
{com}. 
. global gamma = 1 // = B1/B2
{txt}
{com}. global delta = 1 // = (beta_0 pi_0)/(beta_1 pi_1)
{txt}
{com}. 
. global B1 = ($delta * $pistar * $coeff_L1 + $coeff_nu2)/(($delta +1)* $pistar  + 1/$gamma)
{txt}
{com}. global B2 = $B1/$gamma
{txt}
{com}. 
. global beta1 = $coeff_L1 - $B1
{txt}
{com}. global beta2 = $coeff_L2 + ($coeff_nu2 - $B2)
{txt}
{com}. 
. di "B1=" $B1
{res}B1=.09347392
{txt}
{com}. di "beta_1=" $beta1
{res}beta_1=-.18823632
{txt}
{com}. di "beta_2=" $beta2
{res}beta_2=-.16823992
{txt}
{com}. // B1=.4583849
. // beta_1=-.3361487
. // beta_2=-.56536
. 
. cap drop gamma
{txt}
{com}. gen gamma = _n/50 in 12/100
{txt}(294,217 missing values generated)

{com}. forval i = 1(1)20{c -(}
{txt}  2{com}.         global delta = `i'/10
{txt}  3{com}.         cap drop B1 B2
{txt}  4{com}.         gen B1 = ($delta * $pistar * $coeff_L1 + $coeff_nu2)/(($delta +1)* $pistar  + 1/gamma)
{txt}  5{com}.         gen B2 = B1/gamma
{txt}  6{com}.         cap drop beta1_`i' beta2_`i'
{txt}  7{com}.         gen beta1_`i' = $coeff_L1 - B1
{txt}  8{com}.         gen beta2_`i' = $coeff_L2 + ($coeff_nu2 - B2)
{txt}  9{com}. {c )-}
