{com}. 
. * dropping nationalities one-by-one
. rename Libellnationalit1_i1 nationality1_i1
{res}{txt}
{com}. rename Libellnationalit2_i1 nationality2_i1
{res}{txt}
{com}. rename Libellnationalit1_i2 nationality1_i2
{res}{txt}
{com}. rename Libellnationalit2_i2 nationality2_i2
{res}{txt}
{com}. 
. cap erase "$path/Results/TableA29.tex"
{txt}
{com}. cap erase "$path/Results/TableA29.txt"
{txt}
{com}. cap erase "$path/Results/TableA29_1st.tex"
{txt}
{com}. cap erase "$path/Results/TableA29_1st.txt"
{txt}
{com}. 
. foreach Nat in ALGERIENNE ALLEMANDE BELGE ESPAGNOLE ITALIENNE MALGACHE MAROCAINE {c -(}
{txt}  2{com}.         
.         display "Dropping nationality `Nat'"
{txt}  3{com}. 
.         cap drop sample1
{txt}  4{com}.         gen sample1 = 1 if nationality1_i1~="`Nat'" &  nationality1_i2~="`Nat'" & nationality2_i1~="`Nat'" & nationality2_i2~="`Nat'"
{txt}  5{com}. 
.         * IV specification
.         ivreg2 ChangePP (LUL=IG) $Xvar if $condition & sample1==1, noid
{txt}  6{com}.         IVdyadic ChangePP LUL $Xvar if $condition & sample1==1, iv(IG) groups(IGno_i1 IGno_i2)
{txt}  7{com}.         local stderr_IG = e(StdErr)[1,1]
{txt}  8{com}.         local pval = e(pvalues)[1,1]
{txt}  9{com}.         local depvar = e(depvar)
{txt} 10{com}.         sum `depvar' if e(sample)
{txt} 11{com}.         local MeanDepVar = r(mean)
{txt} 12{com}.         local StDevDepVar = r(sd)
{txt} 13{com}.         outreg2 using "$path/Results/TableA29.tex", tex append label addtext(Dropped Nationality, "`Nat'", IV, Yes, Controls, Yes, Dyadic Group Clustering, Yes) addstat(StdErr IG, (`stderr_IG'), p-value, `pval', \textit{c -(}Mean{c )-}(Dep. Var.), `MeanDepVar', \textit{c -(}Std.Dev.{c )-}(Dep. Var.), `StDevDepVar') ctitle(" ") nonotes dec(4) keep(LUL)
{txt} 14{com}. 
.         * First stage
.         ivreg2 LUL IG $Xvar if $condition & sample1==1, noid
{txt} 15{com}.         IVdyadic LUL IG $Xvar if $condition & sample1==1, iv(IG) groups(IGno_i1 IGno_i2)
{txt} 16{com}. 
.         local stderr_IV = e(StdErr)[1,1]
{txt} 17{com}.         local F_KP = e(F_1)
{txt} 18{com}.         local pval = e(pvalues)[1,1]
{txt} 19{com}.         local depvar = e(depvar)
{txt} 20{com}.         sum `depvar' if e(sample)
{txt} 21{com}.         local MeanDepVar = r(mean)
{txt} 22{com}.         local StDevDepVar = r(sd)
{txt} 23{com}.         outreg2 using "$path/Results/TableA29_1st.tex", tex append label addtext(Dropped Nationality, "`Nat'", IV, Yes, Controls, Yes, Dyadic Group Clustering, Yes) addstat(StdErr IV, (`stderr_IV'), Kleibergen-Paap Weak IV F-stat, `F_KP', p-value, `pval', \textit{c -(}Mean{c )-}(Dep. Var.), `MeanDepVar', \textit{c -(}Std.Dev.{c )-}(Dep. Var.), `StDevDepVar') ctitle(" ") nonotes dec(4) keep(IG)
{txt} 24{com}. {c )-}
