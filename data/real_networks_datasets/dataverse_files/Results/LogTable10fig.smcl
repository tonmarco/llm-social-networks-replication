{txt}  5{com}. 
.         local j = `i'+1
{txt}  6{com}.         replace GraphLUL2 = `b' in `j'
{txt}  7{com}.         local stderr = e(StdErr)[1,1]
{txt}  8{com}.         local upper = `b' + `stderr'*1.96
{txt}  9{com}.         local lower = `b' - `stderr'*1.96
{txt} 10{com}.         replace GraphLUL2_upper = `upper' in `j'
{txt} 11{com}.         replace GraphLUL2_lower = `lower' in `j'
{txt} 12{com}.         local stderr = e(StdErr)[1,1]
{txt} 13{com}.         local depvar = e(depvar)
{txt} 14{com}.         sum `depvar' if e(sample)
{txt} 15{com}.         local MeanDepVar = r(mean)
{txt} 16{com}.         local StDevDepVar = r(sd)
{txt} 17{com}.         outreg2 using "${c -(}TeXfile{c )-}", tex append label addtext(IV, Yes, Controls, Yes, Dyadic Group Clustering, Yes, Condition, ${c -(}DiffPP`i'{c )-}) addstat(StdErr LUL, `stderr', \textit{c -(}Mean{c )-}(Dep. Var.), `MeanDepVar', \textit{c -(}Std.Dev.{c )-}(Dep. Var.), `StDevDepVar') ctitle(" ") nonotes dec(4) keep(LUL)
